Windows Registry Editor Version 5.00

; ---- Right-click on images: Image & PDF Tools submenu ----
[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\image\shell\ImagePdfTools]
"MUIVerb"="Image & PDF Tools"
"SubCommands"=""
"Icon"="imageres.dll,-5305"

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\image\shell\ImagePdfTools\shell\01_ConvertToPDF]
@="Convert to PDF"
[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\image\shell\ImagePdfTools\shell\01_ConvertToPDF\command]
@="__PYW__ \"C:\\Scripts\\imagepdf\\main.pyw\" to-pdf \"%1\""

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\image\shell\ImagePdfTools\shell\02_ConvertToPNG]
@="Convert to PNG"
[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\image\shell\ImagePdfTools\shell\02_ConvertToPNG\command]
@="__PYW__ \"C:\\Scripts\\imagepdf\\main.pyw\" to-png \"%1\""

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\image\shell\ImagePdfTools\shell\03_ConvertToJPG]
@="Convert to JPG"
[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\image\shell\ImagePdfTools\shell\03_ConvertToJPG\command]
@="__PYW__ \"C:\\Scripts\\imagepdf\\main.pyw\" to-jpg \"%1\""

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\image\shell\ImagePdfTools\shell\04_Resize50KB]
@="Resize to 50 KB"
[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\image\shell\ImagePdfTools\shell\04_Resize50KB\command]
@="__PYW__ \"C:\\Scripts\\imagepdf\\main.pyw\" resize-kb-50 \"%1\""

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\image\shell\ImagePdfTools\shell\05_Resize100KB]
@="Resize to 100 KB"
[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\image\shell\ImagePdfTools\shell\05_Resize100KB\command]
@="__PYW__ \"C:\\Scripts\\imagepdf\\main.pyw\" resize-kb-100 \"%1\""

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\image\shell\ImagePdfTools\shell\06_Resize150KB]
@="Resize to 150 KB"
[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\image\shell\ImagePdfTools\shell\06_Resize150KB\command]
@="__PYW__ \"C:\\Scripts\\imagepdf\\main.pyw\" resize-kb-150 \"%1\""

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\image\shell\ImagePdfTools\shell\07_Resize300KB]
@="Resize to 300 KB"
[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\image\shell\ImagePdfTools\shell\07_Resize300KB\command]
@="__PYW__ \"C:\\Scripts\\imagepdf\\main.pyw\" resize-kb-300 \"%1\""

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\image\shell\ImagePdfTools\shell\08_ResizeCustomKB]
@="Resize to Custom KB..."
[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\image\shell\ImagePdfTools\shell\08_ResizeCustomKB\command]
@="__PYW__ \"C:\\Scripts\\imagepdf\\main.pyw\" resize-kb-custom \"%1\""

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\image\shell\ImagePdfTools\shell\09_ResizePixels]
@="Resize to Pixel Size..."
[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\image\shell\ImagePdfTools\shell\09_ResizePixels\command]
@="__PYW__ \"C:\\Scripts\\imagepdf\\main.pyw\" resize-pixels \"%1\""

; ---- Right-click on PDFs: Image & PDF Tools submenu ----
[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.pdf\shell\ImagePdfTools]
"MUIVerb"="Image & PDF Tools"
"SubCommands"=""
"Icon"="imageres.dll,-5305"

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.pdf\shell\ImagePdfTools\shell\01_MergeSelected]
